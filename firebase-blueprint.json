{
  "entities": {
    "CommunitySettings": {
      "title": "CommunitySettings",
      "description": "Public organization metadata and optional background images stored in separate docs.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "village": { "type": "string", "minLength": 1, "maxLength": 120 },
        "address": { "type": "string", "maxLength": 240 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "motto": { "type": "string", "maxLength": 200 },
        "mottoBn": { "type": "string", "maxLength": 240 },
        "about": { "type": "string", "maxLength": 2000 },
        "aboutBn": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "village"]
    },
    "SettingAsset": {
      "title": "SettingAsset",
      "description": "Compressed background image data URL or URL for hero or site background.",
      "type": "object",
      "properties": {
        "dataUrl": { "type": "string", "maxLength": 600000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dataUrl"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Explicitly authorized admin UIDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "grantedBy": { "type": "string", "maxLength": 160 }
      },
      "required": ["uid", "email"]
    },
    "RoleGrant": {
      "title": "RoleGrant",
      "description": "Admin-assigned community role mapped by verified member email.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "maxLength": 80 },
        "memberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["email", "role", "memberId"]
    },
    "MemberPublic": {
      "title": "MemberPublic",
      "description": "Community directory profile excluding PII (email/phone).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "memberNo": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "village": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bloodGroup": { "type": "string", "minLength": 1, "maxLength": 10 },
        "skills": { "type": "array" },
        "interests": { "type": "array" },
        "joinDate": { "type": "string", "maxLength": 40 },
        "avatar": { "type": "string", "maxLength": 450000 },
        "bio": { "type": "string", "maxLength": 1000 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 160 }
      },
      "required": ["id", "memberNo", "name", "role", "status", "village", "bloodGroup", "joinDate"]
    },
    "MemberPrivate": {
      "title": "MemberPrivate",
      "description": "Isolated PII contact info for a member, readable only by owner or Admin.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "ownerEmail": { "type": "string", "maxLength": 160 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["email", "phone"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Official notices, news bulletins, and signed PDF circulars.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "titleBn": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "enum": ["Announcement", "Notice", "Education", "Environment", "Sports", "Community"] },
        "categoryBn": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "maxLength": 40 },
        "summary": { "type": "string", "maxLength": 1000 },
        "summaryBn": { "type": "string", "maxLength": 1200 },
        "content": { "type": "string", "maxLength": 10000 },
        "contentBn": { "type": "string", "maxLength": 12000 },
        "image": { "type": "string", "maxLength": 450000 },
        "tagColor": { "type": "string", "enum": ["green", "blue", "purple", "amber"] },
        "status": { "type": "string", "enum": ["Published", "Draft"] },
        "visibility": { "type": "string", "enum": ["public", "members_only"] },
        "pdfAttachment": { "type": "object" }
      },
      "required": ["id", "title", "category", "date", "status", "visibility"]
    },
    "CommunityEvent": {
      "title": "CommunityEvent",
      "description": "Community events with visibility and member RSVP list.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "titleBn": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 40 },
        "time": { "type": "string", "maxLength": 80 },
        "timeBn": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "locationBn": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "enum": ["Meeting", "Environment", "Culture", "Sports", "Education"] },
        "categoryBn": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 4000 },
        "descriptionBn": { "type": "string", "maxLength": 5000 },
        "image": { "type": "string", "maxLength": 450000 },
        "status": { "type": "string", "enum": ["Upcoming", "Past", "Planning"] },
        "visibility": { "type": "string", "enum": ["public", "members_only"] },
        "rsvps": { "type": "array" }
      },
      "required": ["id", "title", "date", "category", "status", "visibility", "rsvps"]
    },
    "Project": {
      "title": "Project",
      "description": "Grassroots village project with progress percentage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "maxLength": 80 },
        "categoryBn": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Ongoing", "Planning", "Completed"] },
        "statusBn": { "type": "string", "maxLength": 80 },
        "progress": { "type": "number" },
        "description": { "type": "string", "maxLength": 4000 },
        "descriptionBn": { "type": "string", "maxLength": 5000 },
        "image": { "type": "string", "maxLength": 450000 },
        "volunteersNeeded": { "type": "number" },
        "volunteersEnrolled": { "type": "number" }
      },
      "required": ["id", "title", "category", "status", "progress"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Photo gallery item displayed on public site.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "maxLength": 80 },
        "categoryBn": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 450000 },
        "date": { "type": "string", "maxLength": 40 },
        "visibility": { "type": "string", "enum": ["public"] }
      },
      "required": ["id", "title", "category", "image", "date", "visibility"]
    },
    "VillageResidentPublic": {
      "title": "VillageResidentPublic",
      "description": "Village census record excluding personal phone and NID.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "residentNo": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameBn": { "type": "string", "maxLength": 160 },
        "village": { "type": "string", "minLength": 1, "maxLength": 100 },
        "para": { "type": "string", "maxLength": 100 },
        "occupation": { "type": "string", "maxLength": 120 },
        "familyMembersCount": { "type": "number" },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "aidStatus": {
          "type": "string",
          "enum": ["General Resident", "Eligible for Aid", "Senior Citizen", "Student / Youth", "Medical Assistance", "Farmer / Daily Wage Earner"]
        },
        "aidStatusBn": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "collectedBy": { "type": "string", "maxLength": 120 },
        "collectedByUid": { "type": "string", "maxLength": 128 },
        "collectedDate": { "type": "string", "maxLength": 40 },
        "updatedDate": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "residentNo", "name", "village", "occupation", "familyMembersCount", "aidStatus", "collectedBy", "collectedDate"]
    },
    "VillageResidentPrivate": {
      "title": "VillageResidentPrivate",
      "description": "Sensitive PII fields (phone, NID/birth cert, guardian name) for a resident.",
      "type": "object",
      "properties": {
        "guardianName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "nidOrBirthCert": { "type": "string", "maxLength": 80 },
        "collectedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["guardianName", "phone"]
    },
    "FundTransaction": {
      "title": "FundTransaction",
      "description": "Audited treasury inflow or outflow voucher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "enum": ["Inflow", "Outflow"] },
        "amount": { "type": "number" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "titleBn": { "type": "string", "maxLength": 300 },
        "donorOrBeneficiary": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "recordedBy": { "type": "string", "maxLength": 120 },
        "recordedByUid": { "type": "string", "maxLength": 128 },
        "voucherNo": { "type": "string", "maxLength": 60 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "date", "type", "amount", "title", "donorOrBeneficiary", "category"]
    },
    "DiscussionPost": {
      "title": "DiscussionPost",
      "description": "Youth discussion forum post and replies.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "authorRole": { "type": "string", "maxLength": 80 },
        "authorAvatar": { "type": "string", "maxLength": 450000 },
        "date": { "type": "string", "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "category": { "type": "string", "enum": ["General", "Project Idea", "Question", "Event Prep"] },
        "likes": { "type": "number" },
        "likedByUids": { "type": "array" },
        "replies": { "type": "array" }
      },
      "required": ["id", "authorUid", "authorName", "authorRole", "date", "text", "category", "likes", "replies"]
    },
    "MemberNotification": {
      "title": "MemberNotification",
      "description": "Dispatched notice or event alert for members.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "titleBn": { "type": "string", "maxLength": 300 },
        "message": { "type": "string", "maxLength": 1500 },
        "messageBn": { "type": "string", "maxLength": 1500 },
        "date": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "enum": ["notice", "event", "system"] },
        "pdfAttachment": { "type": "object" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message", "date", "type", "read"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Membership application submitted to Admin inbox.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "minLength": 4, "maxLength": 40 },
        "village": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "skills": { "type": "string", "maxLength": 400 },
        "interests": { "type": "string", "maxLength": 400 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "date": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "phone", "village", "reason", "status", "date"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Public inquiry message sent to Admin inbox.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "contact": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "date": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Unread", "Read", "Replied"] }
      },
      "required": ["id", "name", "contact", "message", "date", "status"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CommunitySettings" },
      "description": "Community settings (main doc) and background image docs (heroBackground, siteBackground)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Explicitly authorized administrator UIDs."
    },
    "/roleGrants/{email}": {
      "schema": { "$ref": "#/entities/RoleGrant" },
      "description": "Verified email-to-role permissions assigned by Admin."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/MemberPublic" },
      "description": "Non-PII directory profiles of community members."
    },
    "/members/{memberId}/private/{docId}": {
      "schema": { "$ref": "#/entities/MemberPrivate" },
      "description": "Private PII contact info (email, phone) restricted to owner and Admin."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsItem" },
      "description": "Public notices and member-only circulars."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CommunityEvent" },
      "description": "Community events and member RSVPs."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Village development projects."
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Community photo gallery."
    },
    "/villageResidents/{residentId}": {
      "schema": { "$ref": "#/entities/VillageResidentPublic" },
      "description": "Village census household records (non-PII fields)."
    },
    "/villageResidents/{residentId}/private/{docId}": {
      "schema": { "$ref": "#/entities/VillageResidentPrivate" },
      "description": "Sensitive census PII (guardian name, phone, NID/birth cert)."
    },
    "/funds/{fundId}": {
      "schema": { "$ref": "#/entities/FundTransaction" },
      "description": "Treasury cash book transactions managed by Cashier/Admin."
    },
    "/discussions/{postId}": {
      "schema": { "$ref": "#/entities/DiscussionPost" },
      "description": "Youth discussion forum posts and replies."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/MemberNotification" },
      "description": "Member notification feed."
    },
    "/joinRequests/{requestId}": {
      "schema": { "$ref": "#/entities/JoinRequest" },
      "description": "Membership applications readable only by Admin."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact inquiries readable only by Admin."
    }
  }
}
